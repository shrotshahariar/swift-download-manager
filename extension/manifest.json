{
  "manifest_version": 3,
  "name": "Swift DM — Download Catcher",
  "version": "1.1.0",
  "description": "Sends Chrome downloads to the Swift DM app, finds videos, audio and images on pages, and manages downloads from the toolbar.",
  "permissions": ["downloads", "contextMenus", "storage", "cookies", "webRequest", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Swift DM",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
